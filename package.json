{
  "name": "vi-planer",
  "private": true,
  "version": "1.1.0",
  "homepage": "https://bolshakovin.github.io/vi_planer/",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,api -c cyan,magenta \"vite\" \"tsx watch server/index.ts\"",
    "dev:web": "vite",
    "dev:api": "tsx watch server/index.ts",
    "build": "tsc && vite build",
    "build:pages": "VITE_BASE_PATH=/vi_planer/ VITE_LOCAL_STORAGE_ONLY=1 tsc && VITE_BASE_PATH=/vi_planer/ VITE_LOCAL_STORAGE_ONLY=1 vite build --outDir dist-pages",
    "deploy:pages": "npm run build:pages && rm -rf docs && mkdir -p docs && cp -R dist-pages/* docs/ && npm run build",
    "start": "tsx server/index.ts",
    "preview": "npm run build && npm start"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.1",
    "express": "^4.21.2",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.10",
    "@types/pg": "^8.23.1",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vite": "^6.2.2"
  }
}
