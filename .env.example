# Supabase (optional, for GitHub Pages with shared data)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Remote API base URL (optional, for GitHub Pages → Railway backend)
# Example: https://vi-planer-production.up.railway.app
VITE_API_URL=

# GitHub Pages base path (default /vi_planer/ for BolshakovIN/vi_planer)
VITE_BASE_PATH=/vi_planer/
# Set by npm run build:pages — do not set for Railway
# VITE_LOCAL_STORAGE_ONLY=1

# Server
HOST=0.0.0.0
PORT=8787

# Local file storage (used when DATABASE_URL is not set)
# Amvera persistence mount: /data
DATA_DIR=./data

# Docker Compose on VPS
# POSTGRES_PASSWORD=change-me-in-production
# APP_PORT=8787

# PostgreSQL (Railway sets this automatically when you add a Postgres plugin)
DATABASE_URL=

# Disable SSL for local Postgres (Railway uses SSL by default)
# PGSSLMODE=disable

# Allow cross-origin API access from GitHub Pages (optional)
# CORS_ORIGIN=https://bolshakovin.github.io
